// Multi-Tenant Provider Model - Prisma Schema
// ============================================
//
// This schema implements a flexible multi-tenant model where:
//   - Tenant = organization using the platform
//   - Provider = organization offering services/agents to other tenants
//   - The same org can be BOTH tenant and provider
//
// Usage:
//   1. Copy this file to your project's prisma directory
//   2. Update the datasource url to point to your database
//   3. Run: npx prisma migrate dev
//
// Author: InsightPulse AI
// Date: 2026-01-13

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AccountRoleType {
  TENANT
  PROVIDER
  INTERNAL
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum EnvironmentType {
  DEV
  STAGING
  PROD
}

enum AccountLinkType {
  PROVIDER_OF  // from_account is provider for to_account
  RESELLER_OF  // from_account resells to_account
  PARTNER_OF   // symmetric partner relationship
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

/// Accounts represent both tenants and providers.
/// Roles are defined in AccountRole table.
model Account {
  id           String   @id @default(uuid())
  slug         String   @unique /// Human-readable handle (e.g., "tbwa", "insightpulse-ai")
  name         String
  legalName    String?  @map("legal_name")
  country      String?
  timezone     String?  @default("UTC")
  isActive     Boolean  @default(true) @map("is_active")

  // Multi-tenancy hints
  defaultLocale String? @default("en") @map("default_locale")
  billingEmail  String? @map("billing_email")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  roles                  AccountRole[]
  users                  User[]
  providedServices       Service[]      @relation("ProviderServices")
  tenantSubscriptions    Subscription[] @relation("TenantSubscriptions")
  providerSubscriptions  Subscription[] @relation("ProviderSubscriptions")
  environments           Environment[]
  fromLinks              AccountLink[]  @relation("FromAccount")
  toLinks                AccountLink[]  @relation("ToAccount")
  projects               Project[]

  @@map("accounts")
}

/// Defines what roles an account has.
/// An account can have multiple roles (e.g., both TENANT and PROVIDER).
model AccountRole {
  id        String          @id @default(uuid())
  accountId String          @map("account_id")
  role      AccountRoleType
  isPrimary Boolean         @default(false) @map("is_primary")
  createdAt DateTime        @default(now()) @map("created_at")

  // Relations
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@map("account_roles")
}

/// Users belong to one primary account.
model User {
  id        String  @id @default(uuid())
  accountId String  @map("account_id")
  email     String  @unique
  fullName  String? @map("full_name")
  isAdmin   Boolean @default(false) @map("is_admin")
  isActive  Boolean @default(true) @map("is_active")

  // External IDs for integration
  authUserId     String? @map("auth_user_id") /// Supabase auth.users.id
  odooUserId     Int?    @map("odoo_user_id") /// res_users.id mapping
  supersetUserId Int?    @map("superset_user_id") /// Superset ab_user.id

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("users")
}

// ============================================================================
// PROVIDER SIDE: SERVICES & PLANS
// ============================================================================

/// Services are things a provider offers (AI agents, dashboards, etc.)
model Service {
  id                String   @id @default(uuid())
  providerAccountId String   @map("provider_account_id")
  key               String   @unique /// e.g., "scout-dashboard", "ask-copilot"
  name              String
  description       String?
  isPublic          Boolean  @default(false) @map("is_public")

  // Technical hints
  category               String?          @map("category") /// "AI_AGENT", "DASHBOARD", "ERP_INTEGRATION"
  defaultEnvironmentType EnvironmentType? @map("default_environment_type")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  providerAccount Account        @relation("ProviderServices", fields: [providerAccountId], references: [id], onDelete: Cascade)
  plans           ServicePlan[]
  subscriptions   Subscription[]

  @@map("services")
}

/// Pricing tiers for services
model ServicePlan {
  id                String  @id @default(uuid())
  serviceId         String  @map("service_id")
  key               String /// "free", "pro", "enterprise"
  name              String
  description       String?
  monthlyPriceCents Int?    @default(0) @map("monthly_price_cents") /// 0 for free
  maxSeats          Int?    @map("max_seats")
  features          Json?   @default("{}") /// Feature flags

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([serviceId, key])
  @@map("service_plans")
}

// ============================================================================
// TENANT SIDE: SUBSCRIPTIONS & RELATIONSHIPS
// ============================================================================

/// Links tenant accounts to provider services
model Subscription {
  id                String             @id @default(uuid())
  tenantAccountId   String             @map("tenant_account_id")
  providerAccountId String             @map("provider_account_id")
  serviceId         String             @map("service_id")
  servicePlanId     String?            @map("service_plan_id")
  status            SubscriptionStatus @default(DRAFT)

  // Subscription lifecycle
  startedAt   DateTime? @map("started_at")
  endedAt     DateTime? @map("ended_at")
  trialEndsAt DateTime? @map("trial_ends_at")

  // External references
  externalRef String? @map("external_ref") /// Stripe subscription ID, invoice ID, etc.

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenantAccount   Account      @relation("TenantSubscriptions", fields: [tenantAccountId], references: [id], onDelete: Cascade)
  providerAccount Account      @relation("ProviderSubscriptions", fields: [providerAccountId], references: [id], onDelete: Cascade)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  servicePlan     ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)

  @@index([tenantAccountId, serviceId])
  @@map("subscriptions")
}

/// Explicit relationships between accounts.
/// For PROVIDER_OF: from_account is provider, to_account is tenant.
model AccountLink {
  id            String          @id @default(uuid())
  fromAccountId String          @map("from_account_id")
  toAccountId   String          @map("to_account_id")
  linkType      AccountLinkType @map("link_type")
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  fromAccount Account @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@unique([fromAccountId, toAccountId, linkType])
  @@map("account_links")
}

// ============================================================================
// ENVIRONMENTS (SUPABASE / VERCEL / DO BINDINGS)
// ============================================================================

/// Maps accounts to infrastructure
model Environment {
  id        String          @id @default(uuid())
  accountId String          @map("account_id")
  envType   EnvironmentType @map("env_type")

  // Infrastructure bindings
  supabaseProjectRef  String? @map("supabase_project_ref") /// e.g., "cxzllzyxwpyptfretryc"
  vercelProjectId     String? @map("vercel_project_id")
  digitaloceanAppId   String? @map("digitalocean_app_id")
  odooDbName          String? @map("odoo_db_name") /// if mapping per tenant / db
  supersetDatabaseKey String? @map("superset_database_key") /// logical DB name in Superset
  connectionString    String? @map("connection_string") /// encrypted connection string
  apiKey              String? @map("api_key") /// encrypted API key

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, envType])
  @@map("environments")
}

// ============================================================================
// EXAMPLE APP-SCOPED TABLE (ROW-BASED MULTI-TENANCY)
// ============================================================================

/// Example tenant-scoped entity.
/// All domain tables should follow this pattern with tenant_account_id FK.
model Project {
  id              String @id @default(uuid())
  tenantAccountId String @map("tenant_account_id")
  name            String
  key             String /// short code
  status          String @default("active")
  createdByUserId String @map("created_by_user_id")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenantAccount Account @relation(fields: [tenantAccountId], references: [id], onDelete: Cascade)
  createdBy     User    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantAccountId, key])
  @@map("projects")
}
